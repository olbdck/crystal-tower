{
  "name": "crystal-tower",
  "private": true,
  "version": "1.0.0",
  "description": "Cooperative 3D tower defense for up to 5 players in the browser",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:broker": "node tests/support/broker.js",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "npm run test:unit && npm run build && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "balance": "node tests/support/balance.js",
    "test:unit:watch": "node --test --watch \"tests/unit/*.test.js\"",
    "netstats": "node tests/support/netstats.js"
  },
  "dependencies": {
    "mqtt": "5.16.0",
    "three": "0.128.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "aedes": "1.2.0",
    "aedes-server-factory": "0.2.1",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.12"
  }
}
